from colorama import Fore, Style, init

# Inicializa a biblioteca Colorama
init(autoreset=True)

# Lista com os níveis e as situações do reservatório
niveis_agua = [
    "Nível 1 - Muito baixo (CRÍTICO)",
    "Nível 2 - Baixo",
    "Nível 3 - Médio",
    "Nível 4 - Alto",
    "Nível 5 - Muito alto (ALERTA)"
]

# Função que define a cor conforme o nível informado
def definir_cor(nivel):
    if nivel == 1:
        return Fore.RED
    elif nivel == 2:
        return Fore.YELLOW
    elif nivel == 3:
        return Fore.GREEN
    elif nivel == 4:
        return Fore.CYAN
    elif nivel == 5:
        return Fore.BLUE
    else:
        return Fore.WHITE

# Exibe os níveis de água com suas respectivas cores
print("=== MONITORAMENTO DO RESERVATÓRIO ===\n")

for i in range(len(niveis_agua)):
    nivel = i + 1
    cor = definir_cor(nivel)

    print(cor + niveis_agua[i] + Style.RESET_ALL)

print("\nMonitoramento finalizado.")
